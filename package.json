{
  "name": "proyecto-nakasthu-tests",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check:syntax": "node tools/check-syntax.mjs",
    "check:registry": "node tools/check-registry.mjs",
    "test": "node tools/check-syntax.mjs && node tools/check-registry.mjs && vitest run __tests__",
    "test:smoke": "playwright test --config=qa/playwright.config.mjs --project=smoke",
    "test:e2e": "playwright test --config=qa/playwright.config.mjs --project=e2e --project=mobile",
    "test:regression": "playwright test --config=qa/playwright.config.mjs --project=regression",
    "test:browser": "playwright test --config=qa/playwright.config.mjs",
    "test:browser:live": "QA_CDN=live playwright test --config=qa/playwright.config.mjs",
    "qa:report": "node qa/support/report.mjs",
    "qa": "npm test && (npm run test:browser; node qa/support/report.mjs)"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "happy-dom": "^12.0.0",
    "htm": "^3.1.1",
    "motion": "11.18.2",
    "pixelarticons": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "three": "0.180.0",
    "vitest": "^1.0.0",
    "zzfx": "1.4.0"
  }
}
